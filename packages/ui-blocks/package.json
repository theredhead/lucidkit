{
  "name": "@theredhead/lucid-blocks",
  "version": "0.2.1",
  "description": "Higher-level layout compositions for LucidKit — master-detail, navigation pages, dashboards, kanban, and more",
  "license": "MIT",
  "author": "theredhead",
  "keywords": [
    "angular",
    "ui",
    "component-library",
    "lucidkit",
    "signals",
    "standalone",
    "layout",
    "master-detail",
    "dashboard",
    "navigation",
    "kanban",
    "property-sheet"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/theredhead/lucidkit.git",
    "directory": "packages/ui-blocks"
  },
  "homepage": "https://github.com/theredhead/lucidkit#readme",
  "bugs": {
    "url": "https://github.com/theredhead/lucidkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@theredhead/lucid-kit": "^0.2.1",
    "@theredhead/lucid-theme": "^0.2.1",
    "@theredhead/lucid-foundation": "^0.2.1",
    "@angular/cdk": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "rxjs": "^7.8.0"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "build:watch": "ng-packagr -p ng-package.json -c tsconfig.lib.json -w",
    "test": "vitest run --root ../.. packages/ui-blocks/src",
    "test:watch": "vitest --root ../.. packages/ui-blocks/src",
    "test:coverage": "vitest run --root ../.. packages/ui-blocks/src --coverage"
  }
}
