{
  "name": "@theredhead/lucid-kit",
  "version": "0.2.1",
  "description": "Standalone, signal-based Angular UI component library — buttons, inputs, tables, filters, autocomplete, dropdowns, and more",
  "license": "MIT",
  "author": "theredhead",
  "keywords": [
    "angular",
    "ui",
    "component-library",
    "lucidkit",
    "signals",
    "standalone",
    "onpush",
    "button",
    "input",
    "table",
    "filter",
    "autocomplete",
    "dropdown",
    "datepicker"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/theredhead/lucidkit.git",
    "directory": "packages/ui-kit"
  },
  "homepage": "https://github.com/theredhead/lucidkit#readme",
  "bugs": {
    "url": "https://github.com/theredhead/lucidkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "dependencies": {
    "@theredhead/lucid-theme": "^0.2.1"
  },
  "peerDependencies": {
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@theredhead/lucid-foundation": "^0.2.1",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "rxjs": "^7.8.0"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "build:watch": "ng-packagr -p ng-package.json -c tsconfig.lib.json -w",
    "test": "vitest run --root ../.. packages/ui-kit/src",
    "test:watch": "vitest --root ../.. packages/ui-kit/src",
    "test:coverage": "vitest run --root ../.. packages/ui-kit/src --coverage"
  }
}
